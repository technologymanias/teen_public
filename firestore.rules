rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{username} {
      allow read: if request.auth != null;
      // Only you can bring your own profile into existence (stops name squatting).
      allow create: if request.auth != null
                    && request.auth.token.email == username + '@teenpatti.local';
      // Any signed-in player may settle points on your behalf: a round's pot, a
      // top-up or the joiner grant are all written by whoever drove the action.
      allow update: if request.auth != null;
      allow delete: if request.auth != null
                    && request.auth.token.email == username + '@teenpatti.local';
    }
    match /tables/{code} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
