# Copy to .env and fill with your Firebase web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated usernames allowed to add points to other accounts.
# (You can also hardcode them in src/lib/admins.ts instead.)
VITE_ADMIN_USERNAMES=
